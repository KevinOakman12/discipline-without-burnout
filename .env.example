# Скопируй этот файл в .env и заполни значения.
# Файл .env закоммичен в .gitignore — он не уедет на GitHub.

# Токен бота, выданный @BotFather командой /newbot или /token
BOT_TOKEN=

# Публичный HTTPS-адрес, где захостен index.html.
# После включения GitHub Pages это будет:
#   https://<твой-юзернейм>.github.io/<имя-репо>/
WEBAPP_URL=
